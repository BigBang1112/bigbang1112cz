@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    const string SiteName = "BigBang1112.cz";
    var pageTitle = ViewData["Title"] as string;
    var description = ViewData["Description"] as string
        ?? "Petr Pivoňka (BigBang1112), self-taught open-source developer of Trackmania tools and mods, and Drum & Bass producer under the name Realnest.";

    // Link previews need absolute URLs, https like the horn URLs in HornLocatorHost
    var siteUrl = $"https://{Context.Request.Host}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrEmpty(pageTitle) ? SiteName : $"{pageTitle} - {SiteName}")</title>
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#222222" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@SiteName" />
    <meta property="og:title" content="@(pageTitle ?? SiteName)" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@(siteUrl + Context.Request.Path)" />
    <meta property="og:image" content="@(siteUrl)/img/og.jpg" />
    <meta property="og:image:width" content="1205" />
    <meta property="og:image:height" content="352" />
    <meta property="og:image:alt" content="BigBang1112, Petr Pivoňka, developer and music producer" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="importmap"></script>
    @* Starts the font download before the CSS that references it arrives. The URL must match base.css exactly, so no asp-append-version *@
    <link rel="preload" href="/fonts/rubik-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BigBang1112cz.styles.css" asp-append-version="true" />
    <partial name="_Favicons" />
</head>
<body>
    <header>
        <a class="brand" href="/">BigBang1112.cz</a>
        <nav>
            <a href="/" class="@(currentPage == "/Index" ? "active" : "")">Home</a>
            <a href="/projects" class="@(currentPage.StartsWith("/Projects") ? "active" : "")">Projects</a>
            <a href="/links" class="@(currentPage.StartsWith("/Links") ? "active" : "")">Links</a>
            <a href="/music" class="@(currentPage.StartsWith("/Music") ? "active" : "")">Music</a>
            <a href="/blog" class="@(currentPage.StartsWith("/Blog") ? "active" : "")">Blog</a>
            <a href="/contact" class="@(currentPage.StartsWith("/Contact") ? "active" : "")">Contact</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>
        © @DateTime.UtcNow.Year Petr Pivoňka
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
