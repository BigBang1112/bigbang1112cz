@page
@model MusicModel
@using System.Globalization
@using BigBang1112cz.Models.Music
@{
    ViewData["Title"] = "Music";
}

<div class="page-hero">
    <h1>Music</h1>
    <p>Music produced under the alias <strong>Realnest</strong>.</p>
</div>

<div class="page-content">
    <section>
        <div class="music-links">
            <a class="button spotify" href="https://open.spotify.com/artist/4hCfEugmmJX2po152bsceI">Spotify</a>
            <a class="button youtube" href="https://youtube.com/@@realnestmusic">YouTube</a>
            <a class="button soundcloud" href="https://soundcloud.com/realnest">SoundCloud</a>
            <a class="button instagram" href="https://instagram.com/realnestmusic">Instagram</a>
        </div>
        <div class="music-list">
            @foreach (var release in Model.Releases)
            {
                <article class="music-row">
                    <div class="music-info">
                        <h2 class="music-title @(release.Type == MusicReleaseType.Remix ? "remix" : "")">@release.Title</h2>
                        <time class="music-meta" datetime="@release.Released.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">released @release.Released.ToString("d MMMM yyyy", CultureInfo.InvariantCulture)</time>
                        <div class="music-text">@Html.Raw(release.ContentHtml)</div>
                    </div>
                    @if (release.Embed is { } embed)
                    {
                        var (platform, allow) = embed.Platform switch
                        {
                            MusicPlatform.Spotify => ("Spotify", "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"),
                            _ => ("SoundCloud", "autoplay")
                        };

                        <iframe class="music-embed @platform.ToLowerInvariant()" src="@embed.Source" height="@embed.Height" title="@release.Title on @platform" allow="@allow" allowfullscreen loading="lazy"></iframe>
                    }
                </article>
            }
        </div>
    </section>
</div>
